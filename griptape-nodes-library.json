{
    "name": "JEV",
    "library_schema_version": "0.5.0",
    "metadata": {
        "author": "Jason Schleifer",
        "description": "Ask TypeSafe's JEV model typed questions about text and route your flow based on the answer.",
        "library_version": "0.1.0",
        "engine_version": "0.73.0",
        "tags": [
            "Griptape",
            "AI",
            "TypeSafe",
            "JEV"
        ],
        "dependencies": {
            "pip_dependencies": [
                "typesafe-sdk>=0.7.2"
            ]
        }
    },
    "settings": [
        {
            "description": "API keys required by nodes in this library",
            "category": "app_events.on_app_initialization_complete",
            "contents": {
                "secrets_to_register": {
                    "TYPESAFE_API_KEY": ""
                }
            }
        }
    ],
    "categories": [
        {
            "JEV": {
                "color": "border-emerald-500",
                "title": "JEV",
                "description": "Ask TypeSafe's JEV model typed questions about text",
                "icon": "Scale"
            }
        }
    ],
    "nodes": [
        {
            "class_name": "AskYesNo",
            "file_path": "jev_nodes/ask_yes_no.py",
            "metadata": {
                "category": "JEV",
                "description": "Ask a yes/no question about some text and send the flow down the Yes or No branch.",
                "display_name": "Ask Yes/No (Noul)",
                "tags": [
                    "JEV",
                    "TypeSafe",
                    "Noul",
                    "yes/no",
                    "branch",
                    "if",
                    "decision",
                    "classify",
                    "text"
                ]
            }
        },
        {
            "class_name": "PickOne",
            "file_path": "jev_nodes/pick_one.py",
            "metadata": {
                "category": "JEV",
                "description": "Pick the option that best fits some text and send the flow down that option's branch.",
                "display_name": "Pick One (Choice)",
                "tags": [
                    "JEV",
                    "TypeSafe",
                    "Choice",
                    "pick",
                    "branch",
                    "switch",
                    "route",
                    "decision",
                    "classify",
                    "text"
                ]
            }
        }
    ],
    "workflows": [
        "workflows/templates/jev_prompt_clearance.py",
        "workflows/templates/jev_pick_the_look.py"
    ]
}
